<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>MergedCells.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="AutoFixture.Xunit3" Version="4.19.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MergedCells.Core\MergedCells.Core.csproj" />
    <ProjectReference Include="..\..\src\MergedCells.Curation\MergedCells.Curation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\game_config.json" Link="game_config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\levels\*.json" LinkBase="levels" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\campaign\*.json" LinkBase="campaign" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\MergedCells.Curation\*.json" LinkBase="curation" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\MergedCells.Curation\concepts\*.json" LinkBase="curation\concepts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\credits\*.json" LinkBase="credits" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\credits\licences\*.txt" LinkBase="credits\licences" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\themes\fonts\OFL.txt" Link="themes\fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\MergedCells.csproj" Link="MergedCells.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\supabase\levels.sql" Link="supabase\levels.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\icons\icon-art.json" LinkBase="icons" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\icons\*.svg;..\..\icons\*.png" LinkBase="icons" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\icon.svg" Link="icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\cosmetics\*.json" LinkBase="cosmetics" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\themes\*.tres" LinkBase="themes" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\themes\icons\*.svg" LinkBase="themes\icons" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scenes\**\*.tscn" LinkBase="scenes" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\project.godot" Link="project.godot" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\export_presets.cfg" Link="export_presets.cfg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\levels\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
