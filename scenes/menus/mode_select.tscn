[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/menus/ModeSelect.cs" id="1_mode"]
[ext_resource type="Resource" path="res://themes/app_looks.tres" id="2_looks"]
[ext_resource type="Theme" path="res://themes/light_ui_theme.tres" id="3_theme"]
[ext_resource type="Texture2D" path="res://themes/icons/settings.svg" id="4_settings"]
[ext_resource type="Script" path="res://scenes/play/StarsView.cs" id="5_stars"]
[ext_resource type="PackedScene" path="res://scenes/settings/settings_sheet.tscn" id="6_sheet"]
[ext_resource type="PackedScene" path="res://scenes/settings/consent_sheet.tscn" id="7_ask"]

[node name="ModeSelect" type="CanvasLayer"]
script = ExtResource("1_mode")
Looks = ExtResource("2_looks")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("3_theme")

[node name="TopBar" type="MarginContainer" parent="Root"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
mouse_filter = 2
theme_type_variation = &"Bar"

[node name="Row" type="HBoxContainer" parent="Root/TopBar"]
layout_mode = 2
mouse_filter = 2

[node name="Spacer" type="Control" parent="Root/TopBar/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="SettingsButton" type="Button" parent="Root/TopBar/Row"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
size_flags_vertical = 0
focus_mode = 0
theme_type_variation = &"BackButton"
icon = ExtResource("4_settings")
icon_alignment = 1

[node name="Centre" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Column" type="VBoxContainer" parent="Root/Centre"]
custom_minimum_size = Vector2(440, 0)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"ResultsColumn"

[node name="Title" type="Label" parent="Root/Centre/Column"]
layout_mode = 2
theme_type_variation = &"Title"
text = "Merged Cells"
horizontal_alignment = 1

[node name="Total" type="HBoxContainer" parent="Root/Centre/Column"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"TotalRow"
alignment = 1

[node name="Star" type="Control" parent="Root/Centre/Column/Total"]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("5_stars")
ThemeType = "TotalStar"

[node name="TotalLabel" type="Label" parent="Root/Centre/Column/Total"]
layout_mode = 2
theme_type_variation = &"TotalLine"
text = "0"

[node name="Gap" type="Control" parent="Root/Centre/Column"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
mouse_filter = 2

[node name="Campaign" type="Button" parent="Root/Centre/Column"]
layout_mode = 2
focus_mode = 0
